# Copy this file to .env and fill in the values
# Database (PostgreSQL via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/edurank"

# NextAuth
AUTH_SECRET=""        # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Base URL for links in emails (invite/reset).
# MUST be set in production. It is not a nicety: every activation link is built
# from it, and the fallback is http://localhost:3000 — so if this is missing,
# invites go out looking fine and nobody can open a single one.
APP_URL="http://localhost:3000"

# SMTP — dev: Mailpit from docker-compose (host localhost, port 1025, no auth).
# Production: any provider. Nothing in the code names one — see docs/email-setup.md.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EduRank <no-reply@edurank.local>"

# Pause between messages in a bulk invite, in ms (default 250).
# Free tiers throttle bursts far harder than daily totals. Raise it if the
# provider starts refusing; 0 only for tests.
INVITE_DELAY_MS=250

# Backup destination (optional)
# Default: ./backups (local folder, dev only)
# Production: set to a mounted network share, e.g. /mnt/nas/edurank-backups
BACKUP_PATH=
