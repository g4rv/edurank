generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  USER
}

enum AcademicRank {
  LECTURER // викладач
  SENIOR_LECTURER // старший викладач
  DOCENT // доцент
  PROFESSOR // професор
}

enum ScientificDegree {
  CANDIDATE // кандидат наук / доктор філософії (PhD)
  DOCTOR // доктор наук
}

// Entity types that division permissions can apply to
enum EntityType {
  STAFF
  DEPARTMENT
  FACULTY
}

// CRUD actions a division can be granted on an entity type
enum EntityAction {
  CREATE
  UPDATE
  DELETE
}

// How a rating activity gets into the system
enum InputSource {
  NPP_SUBMISSION // НПП submits for themselves; APPROVED on save, see ActivityStatus
  DIVISION_MANAGED // division enters directly, immediately APPROVED
  PROFILE_DERIVED // auto-synced from Staff profile fields; no manual entry anywhere
}

// Administrative position held by an НПП (rating item 1.6) — keys match the
// admin_position select options in lib/rating/evidence-fields.ts
enum AdminPosition {
  VICE_RECTOR // проректор
  DEAN // декан
  VICE_DEAN_OR_SECRETARY // заступник декана / вчений секретар / відп. секретар прийм. комісії
  DEPARTMENT_OR_UNIT_HEAD // завідувач кафедри / керівник відділу
  DEPUTY_DEPARTMENT_HEAD // заступник завідувача кафедри
  DEPUTY_ADMISSION_SECRETARY // заступник відповідального секретаря приймальної комісії
  LAB_OR_CENTER_HEAD // завідувач лабораторії / керівник центру
}

// There is no approval queue: every submit and every division entry writes
// APPROVED and counts at once, and oversight is post-moderation (ННВ/ADMIN
// discard with a reason → REMOVED). PENDING is therefore never written by any
// code path — it is kept only because dropping an enum value needs a migration
// for no gain, and because a future «потребує виправлення» state would land
// here. Do not read it as evidence that a queue exists.
enum ActivityStatus {
  PENDING
  APPROVED
  REMOVED
}

enum SubmittedByRole {
  NPP
  DIVISION
  SYSTEM // profile-derived rows written by syncProfileDerived
}

// ─── Розподіл ставок: a recruited student ────────────────────────────────────

enum StudentDegree {
  BACHELOR // бакалавр
  MASTER // магістр — норматив halves, so the student is worth twice as much
}

enum StudyForm {
  FULL_TIME // денна
  PART_TIME // заочна — норматив ×4, so the student is worth a quarter
}

enum StudentFunding {
  STATE // бюджет — counted in full
  CONTRACT // контракт — multiplied by the year's узгоджуючий коефіцієнт
}

// This is the app's FIRST approval queue, and deliberately so. The rating has
// none: a submission is APPROVED on save and oversight is post-moderation. A
// student claim is the opposite — nothing counts until a human confirms it —
// because a rating entry only affects its own author, while a student claim
// takes a bonus away from a colleague who may have recruited the same person.
//
// `ActivityStatus.PENDING` stays unused; this is a separate status for a
// separate model.
enum ClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Year lifecycle — lives on RatingTemplate (one flag per year, checked by all actions)
enum RatingYearStatus {
  OPEN
  CLOSED
}

// ─── Auth ────────────────────────────────────────────────────────────────────

// One-time "set your password" link emailed to Staff.email. Single-use,
// hashed at rest; one pending token per staff (resend replaces it).
model ActivationToken {
  id        String   @id @default(cuid())
  staffId   String   @unique
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── University structure ────────────────────────────────────────────────────

model Faculty {
  id   String @id @default(cuid())
  name String @unique

  deanId String? @unique
  dean   Staff?  @relation("FacultyDean", fields: [deanId], references: [id])

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id   String @id @default(cuid())
  name String

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  headId String? @unique
  head   Staff?  @relation("DepartmentHead", fields: [headId], references: [id])

  primaryStaff  Staff[]           @relation("PrimaryDepartment")
  partTimeStaff StaffDepartment[]
  stakes        DepartmentStake[]
  distributions StakeDistribution[]
  stakeSandboxes StakeSandbox[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, facultyId])
}

model Division {
  id   String @id @default(cuid())
  name String @unique

  // Stable identity for the divisions the rating catalogue knows about
  // (RATING_DIVISIONS in lib/rating/activity-types.ts): KADRY, NNV, VMZ…
  // `name` is a label an admin edits on /divisions, so matching on it made a
  // rename break re-adding a catalogue indicator and blank the export's «Дані
  // внесені» column. Null for any division an admin creates themselves — they
  // are not part of the catalogue and need no key.
  registryKey String? @unique

  // May this division's editors moderate the rating — discard a wrong НПП
  // self-report with a reason, and toggle «Перевірено» on a publication?
  // Previously decided by matching the name «ННВ», so renaming the division in
  // the UI silently stripped every one of its editors of the right. ADMIN
  // always moderates and needs no row here.
  canModerateRating Boolean @default(false)

  staff             Staff[]
  fieldPermissions  DivisionFieldPermission[]
  entityPermissions DivisionEntityPermission[]
  verifiedTypes     ActivityType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Staff ───────────────────────────────────────────────────────────────────

model Staff {
  id         String @id @default(cuid())
  lastName   String
  firstName  String
  patronymic String

  email String  @unique
  phone String?

  // ── Account (merged from the former User model) ──
  // null = account not activated yet (person never set a password)
  passwordHash String?
  role         Role    @default(USER)
  // Incremented to invalidate all existing sessions for this person
  tokenVersion Int     @default(0)

  activationToken ActivationToken?

  // true = НПП (науково-педагогічний працівник), must belong to a department
  // false = non-НПП (administrative staff), department is optional
  isNpp Boolean @default(true)

  // Off the active roster, without losing a thing. Set when someone leaves, or
  // goes on декретна відпустка: they drop out of the current year's rating and
  // out of every list an editor works from, while all their past activities and
  // closed-year snapshots stay exactly as they were. Restoring is one click, so
  // a person who comes back after three years does not get their history typed
  // in again.
  //
  // There is no hard delete of a person anywhere in the app — this is the only
  // way out, which is what makes closed-year numbers safe.
  //
  // An archived account cannot sign in (see authorize in lib/auth.ts); archiving
  // bumps tokenVersion so any session open at that moment ends immediately.
  archivedAt     DateTime?
  archiveReason  String? // free note: «декрет до 2029», «звільнення» …

  // Confidential: ADMIN sees all, USER sees own, EDITOR never sees
  employmentRate Float?

  pedagogicalExperience Int?

  academicRank            AcademicRank?
  scientificDegree        ScientificDegree?
  degreeMatchesDepartment Boolean?

  // Характеристика п.5 — «Захист дисертації на здобуття наукового ступеня».
  // ONE date, for the highest degree only (decided 2026-08-07), not one per
  // ступінь. That is enough for the licence's «within the last five years» test:
  // the highest degree is also the most recent, so if this date falls outside
  // the window, no earlier defence falls inside it either.
  degreeDefenceDate DateTime?

  // Rating item 1.6 — administrative position (profile-derived indicator)
  adminPosition AdminPosition?

  // Rating item 1.9 — basic education matches the department specialty
  basicEducationMatch     Boolean?
  basicEducationSpecialty String?

  wosUrl                     String?
  wosCitationCount           Int?    @default(0)
  scopusUrl                  String?
  scopusCitationCount        Int?    @default(0)
  googleScholarUrl           String?
  googleScholarCitationCount Int?    @default(0)
  orcidId                    String?

  // Primary department (required for НПП, optional for non-НПП)
  departmentId String?
  department   Department? @relation("PrimaryDepartment", fields: [departmentId], references: [id])

  // Part-time (сумісництво) departments
  partTimeDepartments StaffDepartment[]

  // Division this person belongs to (determines EDITOR permission scope)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])

  headOfDepartment Department? @relation("DepartmentHead")
  deanOfFaculty    Faculty?    @relation("FacultyDean")

  activities    Activity[]
  ratingEntries RatingEntry[]
  stakeLimits   StaffStakeLimits[]
  allocations   StakeAllocation[]
  studentClaims     StudentClaim[] @relation("ClaimAuthor")
  confirmedClaims   StudentClaim[] @relation("ClaimConfirmer")
  filledDistributions StakeDistribution[] @relation("StakeDistributionAuthor")
  stakeSandboxes      StakeSandbox[]

  auditLogs          AuditLog[]
  approvedActivities Activity[]       @relation("ActivityApprover")
  removedActivities  Activity[]       @relation("ActivityRemover")
  verifiedActivities Activity[]       @relation("ActivityVerifier")
  closedTemplates    RatingTemplate[] @relation("TemplateCloser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([divisionId])
  @@index([departmentId])
}

// Part-time (сумісництво) relationships — primary department lives on Staff directly
model StaffDepartment {
  staffId      String
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([staffId, departmentId])
}

// ─── Permissions ─────────────────────────────────────────────────────────────

// Which Staff fields each division's editors can edit
model DivisionFieldPermission {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  fieldName  String

  @@unique([divisionId, fieldName])
}

// Which entity CRUD operations each division can perform
// e.g. { entity: STAFF, action: CREATE } = this division can add new staff records
model DivisionEntityPermission {
  id         String       @id @default(cuid())
  divisionId String
  division   Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  entity     EntityType
  action     EntityAction

  @@unique([divisionId, entity, action])
}

// ─── Rating system (Phase 2) ─────────────────────────────────────────────────

// One template per year; admin clones the previous year and edits differences
model RatingTemplate {
  id       String           @id @default(cuid())
  year     Int              @unique
  name     String
  isActive Boolean          @default(false)
  status   RatingYearStatus @default(OPEN)

  closedAt       DateTime?
  closedByUserId String?
  closedBy       Staff?    @relation("TemplateCloser", fields: [closedByUserId], references: [id])

  sections      RatingSection[]
  activityTypes ActivityType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RatingSection {
  id         String         @id @default(cuid())
  templateId String
  template   RatingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  number     Int // 1–5
  title      String

  activityTypes ActivityType[]

  @@unique([templateId, number])
}

// One row per rating indicator per template (~67 for 2026)
model ActivityType {
  id         String         @id @default(cuid())
  templateId String
  template   RatingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionId  String
  section    RatingSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  order Int
  code  String // stable semantic key, e.g. "publication_cat_a" — survives yearly renumbering
  label String

  itemNumber String // printed item number («3.12») — display + Excel export ordering
  maxPerYear Int? // «не більше N» cap, enforced in the submit actions

  // The admin-editable half of the indicator (template editor v2):
  // evidenceFields — EvidenceField[] form definition (validations/activity-type-spec.ts)
  // scoring        — ScoringSpec, how evidence turns into points (lib/rating/scoring.ts)
  evidenceFields Json
  scoring        Json

  // For FIXED/MULT kinds: points per unit. For SELECT/GATE kinds: 1 (points per option
  // live in the scoring engine, keyed by code).
  coefficient     Float
  coefficientNote String?

  inputSource InputSource

  // Who approves NPP submissions / who enters division-managed values
  verifyingDivisionId String?
  verifyingDivision   Division? @relation(fields: [verifyingDivisionId], references: [id])

  isActive Boolean @default(true)

  // Offers the manual «Перевірено» check on this indicator's rows (ННВ confirms
  // the publication really is in WoS/Scopus). Informational — it never changes a
  // score. Was a hardcoded list of two publication codes, which left an
  // admin-built publication indicator with no way to be checked; keying rating
  // behaviour on `code` is exactly what the template editor exists to avoid.
  requiresVerification Boolean @default(false)

  // Offers the bulk entity-first dialog on /division-data: enter the object
  // (проєкт / рада / освітня програма) once, pick everyone involved, fan out one
  // Activity each. Was a hardcoded list of 17 codes in lib/rating/entity-entry.ts,
  // which left an admin-built indicator of the same shape stuck on the
  // one-cell-at-a-time grid with nothing to explain why.
  entityFirstEntry Boolean @default(false)

  // Which п.38 positions of the Характеристика this indicator's entries satisfy:
  // LicencePositionLink[] — see validations/licence-positions.ts. Empty for most
  // indicators, and empty ON PURPOSE for patent_application and
  // intl_grant_application: an application scores in the rating but closes no
  // licence position.
  //
  // A column rather than a list in code for the same reason requiresVerification
  // and entityFirstEntry became columns — a code list silently excludes every
  // indicator an admin builds themselves, and the вчена рада votes new
  // indicators in yearly.
  licencePositions Json @default("[]")

  activities Activity[]

  @@unique([templateId, code])
  @@index([verifyingDivisionId])
}

// One row per submitted/entered activity. Repeatable types may have several rows
// per (staff, type, year) — deliberately NO unique constraint on that triple.
model Activity {
  id String @id @default(cuid())

  staffId        String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id])

  // Denormalized from activityType.template.year — always derived server-side, never client input
  year Int

  evidence      Json
  computedValue Float
  score         Float // computedValue × coefficient; recomputed and frozen at approval

  // Every writer sets this explicitly, so the default is never reached in
  // practice — see the note on ActivityStatus before treating it as a queue
  status          ActivityStatus  @default(PENDING)
  submittedByRole SubmittedByRole

  approvedByUserId String?
  approvedBy       Staff?    @relation("ActivityApprover", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  removedByUserId String?
  removedBy       Staff?    @relation("ActivityRemover", fields: [removedByUserId], references: [id])
  removedAt       DateTime?
  removeReason    String?

  // Manual ННВ check for publication submissions (M9.1): «Перевірено» in WoS/Scopus.
  // A future DOI-checker worker writes here too — the flag stays the human final say.
  verifiedByUserId String?
  verifiedBy       Staff?    @relation("ActivityVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, year])
  @@index([activityTypeId, status])
}

// Cached per-staff/year rollup of approved activity scores; snapshot frozen at year close
model RatingEntry {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  year    Int

  section1Score Float @default(0)
  section2Score Float @default(0)
  section3Score Float @default(0)
  section4Score Float @default(0)
  section5Score Float @default(0)
  totalScore    Float @default(0)

  // Full rating (labels + coefficients + scores) as of year close — authoritative for closed years
  snapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, year])
}

// ─── Розподіл ставок ─────────────────────────────────────────────────────────
//
// Full specification: docs/stake-distribution.md. Three facts that shape every
// model here and are easy to lose:
//
//   1. EVERY ставка value is stored as INTEGER HUNDREDTHS, never as a float.
//      The old system used floats and produced negative «нерозподілено» — a
//      кафедра that had overspent according to a subtraction and had not
//      according to the people in it. See lib/stake/units.ts.
//
//   2. `Кст` bounds the FIRST TERM ONLY. The pool is spread by rating and the
//      head may never exceed it; recruitment bonuses are paid ON TOP, outside
//      the pool. A кафедра total above `Кст` is correct if and only if the
//      difference is exactly the bonuses.
//
//   3. There is NO APPROVAL STEP (decided 2026-08-10, retracting Q1). ADMIN
//      sets the pool, the завідувач spreads it, and that is final. Do not add a
//      SUBMITTED/APPROVED status or an approver id.

// A speciality students are recruited into. The name is what a claim is matched
// against; the code («012», «015.05») is documentation and may be absent.
model Speciality {
  id   String  @id @default(cuid())
  name String  @unique
  code String?

  norms  SpecialityNorm[]
  claims StudentClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Норматив чисельності здобувачів на 1 ставку — додаток 5, per year.
//
// ONE number per speciality, not four. Verified across all 38 rows: every
// printed column follows the law's multipliers off a single base
// (магістр ×0.5, заочна ×4), so storing four would be four chances to disagree.
// Yearly data rather than a constant, because the вчена рада re-approves the
// table each year and the app must follow whatever it approves.
model SpecialityNorm {
  id           String     @id @default(cuid())
  specialityId String
  speciality   Speciality @relation(fields: [specialityId], references: [id], onDelete: Cascade)
  year         Int

  /// Бакалавр, денна. Everything else is derived — see lib/stake/norms.ts
  base Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([specialityId, year])
  @@index([year])
}

// One student an НПП says they recruited — term 2 of the ставка formula.
//
// **Adding is silent on purpose.** An НПП is never told that somebody else has
// already claimed the same student, and nothing is blocked at save. The
// duplicate IS the evidence, and it is shown only to the person who can judge
// it. Blocking the second claim was considered and rejected: it would hand the
// ставка to whoever typed first rather than to whoever did the work, and would
// leave the head with one row and no conflict to see.
//
// A speciality belongs to no кафедра — an НПП may recruit onto any programme in
// the university, and the bonus follows the RECRUITER wherever the student ends
// up studying (confirmed 2026-08-10).
model StudentClaim {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation("ClaimAuthor", fields: [staffId], references: [id], onDelete: Cascade)
  year    Int

  studentName String
  /// Trimmed, lower-cased, spaces collapsed — the key duplicates are found on.
  /// Stored rather than computed at query time so the index can be used.
  studentNameNormalised String

  specialityId String
  speciality   Speciality @relation(fields: [specialityId], references: [id])

  degree  StudentDegree
  form    StudyForm
  funding StudentFunding

  status       ClaimStatus @default(PENDING)
  rejectReason String?

  confirmedById String?
  confirmedBy   Staff?    @relation("ClaimConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  /// «Who was first» — evidence for the head, never an automatic winner
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same НПП adding the same student twice is their own slip, and blocked.
  /// Two DIFFERENT people claiming one student is the case this feature exists
  /// for and must stay possible.
  @@unique([staffId, year, studentNameNormalised, specialityId])
  @@index([year, studentNameNormalised])
  @@index([staffId, year])
}

// What the вчена рада approves for the year, beyond the norms themselves.
model StakeYearSettings {
  year Int @id

  /// Узгоджуючий коефіцієнт for контракт students — 0.175 for 2026 (confirmed
  /// 2026-08-07). A per-year setting, not a constant: the вчена рада can move it.
  contractCoefficient Float @default(0.175)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// `Кст` — the pool of ставки a кафедра has to spread, set centrally by
// ADMIN/проректор and never by the head.
//
// `Кнпп` is deliberately NOT stored: it is derived from the Характеристика
// (lib/queries/get-department-knpp.ts) and would go stale the moment somebody
// submits an achievement. Freezing it belongs with the distribution grid, where
// there is a distribution to freeze it against.
model DepartmentStake {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int

  /// Integer hundredths. Validated against 0.1 × (НПП on the кафедра): a pool
  /// that cannot pay the floor to everyone is bad input, not a decision.
  kstHundredths Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, year])
  @@index([year])
}

// Per-person floor and ceiling, applied AFTER the formula: final = clamp(Vc, min, max).
//
// The формула alone cannot reproduce what the university actually does — 39 % of
// the 2025 distribution sits exactly on a per-person cap and none exceeds one.
//
// ADMIN only, deliberately: a завідувач distributes inside limits they cannot
// change, which is what stops a head capping colleagues down and themselves up.
model StaffStakeLimits {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  year    Int

  /// Integer hundredths. The lowest a floor may go is 10 (0.1), never 0 — a
  /// deliberate override of the положення's «менше 0,5 → встановлюється 0,5».
  minHundredths Int
  maxHundredths Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, year])
  @@index([year])
}

// One кафедра's distribution for one year. There is exactly one — there is no
// approval step (decided 2026-08-10, retracting Q1), so no second version to
// compare against and no approver to record.
//
// `filledAt` is NOT a status and grants nobody a veto. Its whole job is that a
// кафедра nobody has opened reads as «не заповнено» rather than as «everyone
// gets nothing» — in the 2025 file those two were indistinguishable and both
// zeroed a whole кафедра.
model StakeDistribution {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int

  filledAt   DateTime?
  filledById String?
  filledBy   Staff?    @relation("StakeDistributionAuthor", fields: [filledById], references: [id])

  allocations StakeAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, year])
  @@index([year])
}

// One person's row in it — додаток 2's «Обсяг ставки за формулою», «Розподілений
// обсяг ставки» and «Обґрунтування», which is why both numbers are kept.
model StakeAllocation {
  id             String            @id @default(cuid())
  distributionId String
  distribution   StakeDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  staffId        String
  staff          Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// What the formula proposed, frozen at save. Kept because додаток 2 prints
  /// it beside the head's number — the document IS the comparison.
  formulaHundredths Int
  /// What the head decided. Σ of these may never exceed `Кст`.
  proposedHundredths Int
  /// Required when the two differ — додаток 2's «Обґрунтування» column
  justification String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([distributionId, staffId])
}

// ADMIN's scratch pad for one кафедра — «що буде, якщо».
//
// ADMIN owns `Кст` and the per-person caps but must never write a кафедра's
// actual split: that is the head's decision, and an ADMIN who could quietly
// overwrite it would make «завідувач розподіляє» untrue (decided 2026-08-12).
// Yet ADMIN is the one person who needs to see what a different pool or a
// different cap would do — so the trying-out happens here, in a table nothing
// else reads.
//
// Per (admin, кафедра, year): two admins comparing two pools do not overwrite
// each other, and neither of them retypes a кафедра after a reload.
//
// One row for the whole кафедра rather than one per person, and JSON rather
// than columns, because nothing ever queries inside it. The grid already saves
// the кафедра in a single write; a row per person would turn a scratch pad into
// N writes per keystroke-batch.
model StakeSandbox {
  id           String     @id @default(cuid())
  userId       String
  user         Staff      @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  year         Int

  /// The pool being tried, in hundredths. Null = the кафедра's real `Кст`.
  kstHundredths Int?
  /// `{ staffId: hundredths }` — what was typed into «Розподілено»
  values Json @default("{}")
  /// `{ staffId: { min, max } }` — caps being tried, overriding StaffStakeLimits
  limits Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, departmentId, year])
  @@index([year])
}

// Failed sign-in counters, one row per subject.
//
// On a university LAN an unthrottled password form was tolerable; on a public
// VPS with a real domain it is not, and the 2026-07-29 audit called it a
// deployment blocker (S4).
//
// A table rather than memory, deliberately: an in-process counter resets on
// every redeploy, and a redeploy is exactly the moment somebody probing would
// like it to. ~300 people means a handful of rows.
//
// `subject` carries its own kind — «email:…» or «ip:…» — because both are
// counted and each closes a hole the other leaves open. Per-email alone lets
// somebody spray one password across every address they can guess; per-IP alone
// lets a botnet grind one account from a thousand hosts. Neither is enough on
// its own, and the two never need to be joined, so one table with a prefixed
// key beats two tables or a nullable pair.
model LoginThrottle {
  id      String @id @default(cuid())
  /// «email:kovalenko@uhsp.edu.ua» or «ip:203.0.113.4», lower-cased
  subject String @unique

  /// Failures since the last success or the last lockout expiry
  failures Int @default(0)
  /// How many lockouts this subject has already served. Drives the escalation
  /// (1 → 5 → 15 → 60 minutes) and is what makes a persistent guesser pay more
  /// than somebody who mistyped their password twice in a bad morning.
  lockLevel   Int       @default(0)
  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Swept by `pruneLoginThrottles` — a row nobody has touched for a day is
  /// somebody who got their password right eventually.
  @@index([updatedAt])
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String // "CREATE" | "UPDATE" | "DELETE"
  entity    String // model name, e.g. "Staff"
  entityId  String
  label     String? // human-readable description, e.g. "Updated Коваленко І.П."
  changes   Json? // { field: { from, to } } for UPDATE; { field: { from: null, to: value } } for CREATE; vice versa for DELETE
  userId    String? // kept even if the staff row is later deleted
  user      Staff?  @relation(fields: [userId], references: [id])
}
